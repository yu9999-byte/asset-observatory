a,a:not([href]):not([tabindex]){color:var(--c-color-text-hyperlink);text-decoration:none;cursor:pointer;}/*!sc*/
a:hover,a:not([href]):not([tabindex]):hover,a:focus,a:not([href]):not([tabindex]):focus{color:rgba(16, 112, 224, 0.85);text-decoration:underline;}/*!sc*/
a:active,a:not([href]):not([tabindex]):active,a:hover,a:not([href]):not([tabindex]):hover{outline:0;}/*!sc*/
figure{padding:0;margin:0;}/*!sc*/
hr{border:0 none;height:1px;background-color:#f5f7f8;margin:0 0 24px;}/*!sc*/
