html,body{padding:0;margin:0;}/*!sc*/
body{background:var(--c-color-background-2);color:var(--c-color-text-primary);text-size-adjust:100%;font-size:15px;line-height:1.5em;vertical-align:baseline;display:flex;min-height:100vh;flex-direction:column;font-smoothing:antialiased;}/*!sc*/
